{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "TLDT",
  "colors": {
    "primary": "#0069c5",
    "light": "#0088ff",
    "dark": "#137bf2"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/tldt-light.svg",
    "dark": "/logo/tldt-dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": ["overview", "quickstart", "how-tldt-works", "profile"]
      },
      {
        "group": "Career Memory",
        "pages": [
          "memory/overview",
          "memory/import-guide",
          "memory/drafts-and-documents",
          "memory/generate-derived",
          "memory/publish"
        ]
      },
      {
        "group": "Find a role",
        "pages": ["jobs/search", "jobs/instant-fit", "jobs/saved-vacancies"]
      },
      {
        "group": "Prepare and improve",
        "pages": [
          "public-profile/fast-check",
          "owner-review/simulate",
          "memory/gaps",
          "memory/loop"
        ]
      },
      {
        "group": "Represent and share",
        "pages": [
          "owner-review/preview",
          "settings/public-link",
          "public-profile/overview",
          "public-profile/chat",
          "owner-review/sessions",
          "sharing",
          "settings/meetings"
        ]
      },
      {
        "group": "Settings and privacy",
        "pages": [
          "settings/integrations",
          "account",
          "faq"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      { "label": "Open TLDT", "href": "https://tldt.me" }
    ],
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://tldt.me/login"
    }
  },
  "appearance": {
    "default": "system",
    "strictlyUseCustomColor": true
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {}
  },
  "description": "Build Career Memory, find relevant jobs, check fit, practice interviews, improve your Memory, and choose what your AI representative can share."
}
